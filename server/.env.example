# Server Port (auto-assigned by Render/Railway/Fly)
PORT=4000
NODE_ENV=production

# PostgreSQL connection string (Neon, Supabase, Render, Railway, AWS RDS)
DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# Frontend Client URL (e.g. https://begenarxiv.vercel.app or https://begenarxiv.com)
CLIENT_URL=http://localhost:5173

# Admin curator access password for /portal
ADMIN_PASSWORD=your_curator_secret_password

# Email Notifications (Gmail SMTP or custom provider)
ADMIN_EMAIL=nebiyoutahoa@gmail.com
SMTP_USER=nebiyoutahoa@gmail.com
# Google App Password generated at https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_character_app_password

